{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "status",
    "context",
    "execution",
    "artifacts",
    "acceptance",
    "error"
  ],
  "properties": {
    "schema": {
      "const": "scene_task_result_v1"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "context": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "artifacts": {
      "type": "array"
    },
    "acceptance": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
