{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "autonomous_patch_decision_v1"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "patch",
        "diagnose",
        "stop"
      ]
    },
    "failure_reason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim": {
                "type": "string",
                "maxLength": 12000
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "required": [
              "claim",
              "evidence_ids"
            ]
          }
        },
        "mechanism": {
          "type": "string",
          "maxLength": 12000
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 12000
          },
          "maxItems": 20
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 12000
          },
          "maxItems": 20
        }
      },
      "required": [
        "observations",
        "mechanism",
        "hypotheses",
        "unresolved"
      ]
    },
    "edit_instruction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario_contract": {
          "const": "preserve"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "original551",
              "cutin551"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "scenario_contract",
        "cases"
      ]
    },
    "patch_instruction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 12000
        },
        "rationale": {
          "type": "string",
          "maxLength": 12000
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "joint_safety.py"
              },
              "op": {
                "const": "replace_exact"
              },
              "before": {
                "type": "string",
                "maxLength": 60000
              },
              "after": {
                "type": "string",
                "maxLength": 60000
              }
            },
            "required": [
              "path",
              "op",
              "before",
              "after"
            ]
          },
          "maxItems": 8
        },
        "causal_test": {
          "type": "string",
          "maxLength": 60000
        }
      },
      "required": [
        "summary",
        "rationale",
        "operations",
        "causal_test"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "trace_window",
              "source_method",
              "matched_replay_summary"
            ]
          },
          "item_id": {
            "type": "string",
            "maxLength": 200
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "kind",
          "item_id",
          "start",
          "end"
        ]
      },
      "maxItems": 4
    }
  },
  "required": [
    "schema",
    "evidence_sha256",
    "decision",
    "failure_reason",
    "edit_instruction",
    "patch_instruction",
    "diagnostics"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
